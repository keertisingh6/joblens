rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile: only the authenticated user can read & write their profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Scans collection: users can manage their own scan analyses
    match /scans/{scanId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Chat threads: multi-turn Gemini conversation threads per user
    match /chatThreads/{threadId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
